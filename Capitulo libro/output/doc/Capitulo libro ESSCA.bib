	file = {PDF:C\:\\Users\\LEONA\\Zotero\\storage\\R3MBQFMB\\Konar et al. - 2026 - Community Resident and Sustainable Cultural Heritage Tourism Development A Systematic Literature Re.pdf:application/pdf},
}

